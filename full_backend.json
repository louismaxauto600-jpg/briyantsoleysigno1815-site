{
  "BACKEND_BLUEPRINT_FINAL": {
    "DATABASE": {
      "FAN_UPLOADS": [
        {
          "id": "",
          "fan_name": "",
          "fan_email": "",
          "file_url": "",
          "file_type": "",
          "description": "",
          "status": "",
          "upload_date": ""
        }
      ],
      "LEADERS_UPLOADS": [
        {
          "id": "",
          "admin_name": "",
          "category": "",
          "file_url": "",
          "file_type": "",
          "description": "",
          "upload_date": ""
        }
      ],
      "PRODUCTS_MEDIA": [
        {
          "id": "",
          "product_name": "",
          "product_category": "",
          "file_url": "",
          "file_type": "",
          "upload_date": ""
        }
      ],
      "BANNERS_LIBRARY": [
        {
          "id": "",
          "banner_title": "",
          "file_url": "",
          "upload_date": ""
        }
      ],
      "EVENTS_MEDIA": [
        {
          "id": "",
          "event_name": "",
          "file_url": "",
          "file_type": "",
          "upload_date": ""
        }
      ]
    },

    "RULES": {
      "ACCESS_LEVELS": {
        "FAN": {
          "can_upload": true,
          "can_view_library": false,
          "can_edit": false,
          "can_delete": false
        },
        "ADMIN": {
          "can_upload": true,
          "can_view_library": true,
          "can_edit": true,
          "can_delete": true,
          "can_approve_fan_uploads": true
        },
        "SUPER_ADMIN": {
          "can_upload": true,
          "can_view_library": true,
          "can_edit": true,
          "can_delete": true,
          "can_manage_categories": true,
          "full_control": true
        }
      },
      "UPLOAD_RULES": {
        "fan_uploads": {
          "allowed_types": ["photo", "video"],
          "max_size_mb": 25,
          "status_flow": ["pending", "approved", "rejected"],
          "review_required": true
        },
        "leaders_uploads": {
          "allowed_types": ["photo", "video"],
          "categories": ["store", "event", "leadership", "fanclub", "banner", "product"],
          "review_required": false
        }
      },
      "CONTENT_POLICIES": {
        "prohibited_content": [
          "nudity",
          "violence",
          "hate_symbols",
          "copyrighted_material_without_permission",
          "political_propaganda",
          "religious_attacks"
        ],
        "auto_reject_if": [
          "file_corrupted",
          "virus_detected",
          "invalid_format"
        ]
      },
      "WORKFLOW": {
        "fan_upload_process": [
          "fan_submits_media",
          "media_enters_pending_queue",
          "admin_reviews",
          "admin_approves_or_rejects",
          "approved_media_goes_to_fanclub_section"
        ],
        "leaders_upload_process": [
          "leader_uploads_media",
          "media_goes_directly_to_assigned_category",
          "super_admin_can_override_any_media"
        ]
      },
      "SECURITY": {
        "logging": {
          "track_uploads": true,
          "track_edits": true,
          "track_deletions": true,
          "track_admin_actions": true
        },
        "backup": {
          "auto_backup_enabled": true,
          "frequency": "daily",
          "retention_days": 30
        }
      },
      "SYSTEM_BEHAVIOR": {
        "auto_generate_id": true,
        "auto_timestamp_upload": true,
        "auto_sort_by_date": true,
        "max_items_per_page": 50
      }
    },

    "API_ROUTES": {
      "FAN_UPLOADS": {
        "POST /fan/uploads": "Fan uploads media (photo/video)",
        "GET /fan/uploads/:id": "Get single fan upload",
        "GET /fan/uploads/pending": "Admin fetch pending uploads",
        "PUT /fan/uploads/:id/approve": "Admin approves fan upload",
        "PUT /fan/uploads/:id/reject": "Admin rejects fan upload",
        "DELETE /fan/uploads/:id": "Admin or Super Admin deletes fan upload"
      },
      "LEADERS_UPLOADS": {
        "POST /leaders/uploads": "Admin or Super Admin uploads media",
        "GET /leaders/uploads": "Fetch all leaders uploads",
        "GET /leaders/uploads/:id": "Fetch single leader upload",
        "PUT /leaders/uploads/:id": "Edit leader upload",
        "DELETE /leaders/uploads/:id": "Delete leader upload"
      },
      "PRODUCTS_MEDIA": {
        "POST /products/media": "Upload product image/video",
        "GET /products/media": "Get all product media",
        "GET /products/media/:id": "Get single product media",
        "PUT /products/media/:id": "Edit product media",
        "DELETE /products/media/:id": "Delete product media"
      },
      "BANNERS_LIBRARY": {
        "POST /banners": "Upload banner",
        "GET /banners": "Get all banners",
        "GET /banners/:id": "Get single banner",
        "PUT /banners/:id": "Edit banner",
        "DELETE /banners/:id": "Delete banner"
      },
      "EVENTS_MEDIA": {
        "POST /events/media": "Upload event media",
        "GET /events/media": "Get all event media",
        "GET /events/media/:id": "Get single event media",
        "PUT /events/media/:id": "Edit event media",
        "DELETE /events/media/:id": "Delete event media"
      },
      "SYSTEM": {
        "GET /system/health": "Check API health",
        "GET /system/stats": "Get media library statistics",
        "GET /system/logs": "Super Admin only — view logs"
      },
      "AUTH": {
        "POST /auth/login": "User login",
        "POST /auth/logout": "User logout",
        "GET /auth/me": "Get current user info"
      }
    },

    "CONTROLLERS": {
      "FAN_UPLOADS_CONTROLLER": {
        "createFanUpload": "Receive fan media, validate, save to FAN_UPLOADS",
