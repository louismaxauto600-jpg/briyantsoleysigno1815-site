<!-- FILE: member-id-center.html -->
<!DOCTYPE html>
<html lang="ht">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Member ID Center | BSS1815 PRO-MAX-DMP</title>

<style>
*{margin:0;padding:0;box-sizing:border-box}

body{
font-family:Arial,sans-serif;
background:linear-gradient(135deg,#000000,#ff6a00,#000000);
color:#fff;
min-height:100vh;
}

header{
background:#000;
padding:35px;
text-align:center;
border-bottom:3px solid #ff7a00;
}

header h1{
color:#ff7a00;
font-size:42px;
}

.container{
width:min(1400px,95%);
margin:30px auto;
}

.card{
background:#111;
border:2px solid #ff7a00;
border-radius:15px;
padding:20px;
margin-bottom:25px;
}

.card h2{
color:#ff7a00;
margin-bottom:15px;
}

.grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:15px;
}

label{
display:block;
margin-top:10px;
margin-bottom:5px;
color:#ffb366;
font-weight:bold;
}

input,select{
width:100%;
padding:12px;
border-radius:10px;
border:1px solid #ff7a00;
background:#000;
color:#fff;
}

button{
margin-top:15px;
padding:12px 20px;
background:#ff7a00;
color:#000;
border:none;
border-radius:10px;
font-weight:bold;
cursor:pointer;
}

.id-card{
width:380px;
background:linear-gradient(135deg,#000000,#ff6a00);
border:3px solid #ff7a00;
border-radius:20px;
padding:20px;
margin-top:20px;
}

.id-header{
text-align:center;
margin-bottom:15px;
}

.id-header h3{
color:#fff;
}

.id-photo{
width:100px;
height:100px;
border-radius:50%;
border:3px solid #fff;
overflow:hidden;
margin:auto;
background:#000;
}

.id-photo img{
width:100%;
height:100%;
object-fit:cover;
}

.id-info{
margin-top:15px;
line-height:1.8;
}

.qr-box{
background:#fff;
color:#000;
padding:10px;
margin-top:15px;
text-align:center;
border-radius:10px;
font-size:12px;
}

table{
width:100%;
border-collapse:collapse;
margin-top:20px;
}

th{
background:#ff7a00;
color:#000;
padding:12px;
}

td{
border:1px solid #ff7a00;
padding:10px;
background:#000;
}

footer{
margin-top:40px;
padding:20px;
text-align:center;
background:#000;
border-top:3px solid #ff7a00;
}
</style>
</head>

<body>

<header>
<h1>MEMBER ID CENTER</h1>
<p>BSS1815 PRO-MAX-DMP</p>
<p>DEVAN DEVAN NÈT. PARE POU DEMEN.</p>
</header>

<div class="container">

<section class="card">

<h2>Create Member ID</h2>

<div class="grid">

<div>
<label>Full Name</label>
<input type="text" id="memberName">
</div>

<div>
<label>Member ID</label>
<input type="text" id="memberId">
</div>

<div>
<label>Category</label>
<select id="memberCategory">
<option>Member</option>
<option>Musician</option>
<option>Fanatik</option>
<option>Volunteer</option>
<option>Admin</option>
<option>Moderator</option>
<option>Super Admin</option>
</select>
</div>

<div>
<label>Phone</label>
<input type="text" id="memberPhone">
</div>

<div>
<label>Expiration Date</label>
<input type="date" id="expirationDate">
</div>

<div>
<label>Photo</label>
<input type="file" id="memberPhoto" accept="image/*">
</div>

</div>

<button onclick="generateID()">Generate ID Card</button>

</section>

<section class="card">

<h2>Member ID Preview</h2>

<div id="cardPreview"></div>

</section>

<section class="card">

<h2>Member Registry</h2>

<table>
<thead>
<tr>
<th>Member ID</th>
<th>Name</th>
<th>Category</th>
<th>Phone</th>
<th>Expiration</th>
</tr>
</thead>

<tbody id="memberTable"></tbody>

</table>

</section>

</div>

<footer>
© 2026 BSS1815 PRO-MAX-DMP | Member ID Center
</footer>

<script>

let members =
JSON.parse(localStorage.getItem("bss1815_member_ids")) || [];

function generateID(){

const file =
document.getElementById("memberPhoto").files[0];

const reader = new FileReader();

reader.onload = function(e){

const member = {

name:
document.getElementById("memberName").value,

id:
document.getElementById("memberId").value,

category:
document.getElementById("memberCategory").value,

phone:
document.getElementById("memberPhone").value,

expiration:
document.getElementById("expirationDate").value,

photo:
e.target.result,

created:
new Date().toLocaleString()

};

members.unshift(member);

localStorage.setItem(
"bss1815_member_ids",
JSON.stringify(members)
);

document.getElementById("cardPreview").innerHTML =

`
<div class="id-card">

<div class="id-header">
<h3>BSS1815 PRO-MAX-DMP</h3>
</div>

<div class="id-photo">
<img src="${member.photo}">
</div>

<div class="id-info">
<strong>Name:</strong> ${member.name}<br>
<strong>ID:</strong> ${member.id}<br>
<strong>Category:</strong> ${member.category}<br>
<strong>Phone:</strong> ${member.phone}<br>
<strong>Expires:</strong> ${member.expiration}
</div>

<div class="qr-box">
QR: ${member.id}
</div>

</div>
`;

renderMembers();

};

if(file){
reader.readAsDataURL(file);
}

}

function renderMembers(){

const table =
document.getElementById("memberTable");

table.innerHTML = "";

members.forEach(member=>{

table.innerHTML += `
<tr>
<td>${member.id}</td>
<td>${member.name}</td>
<td>${member.category}</td>
<td>${member.phone}</td>
<td>${member.expiration}</td>
</tr>
`;

});

}

renderMembers();

</script>

</body>
</html>
