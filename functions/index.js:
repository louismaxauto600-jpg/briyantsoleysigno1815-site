// ---------------------------------------------
// 🟢 WHATSAPP WEBHOOK - TWILIO SANDBOX +14155238886
// ---------------------------------------------
exports.whatsappWebhook = functions.https.onRequest(async (req, res) => {
  try {
    const { From, To, Body, NumMedia, MessageSid, ProfileName } = req.body;

    const medias = [];
    const numMedia = parseInt(NumMedia || "0", 10);
    for (let i = 0; i < numMedia; i++) {
      medias.push({
        url: req.body[`MediaUrl${i}`],
        contentType: req.body[`MediaContentType${i}`],
      });
    }

    await db.collection("whatsapp_messages").doc(MessageSid).set({
      messageSid: MessageSid,
      from: From || "",
      to: To || "",
      profileName: ProfileName || "",
      body: Body || "",
      medias: medias,
      numMedia: numMedia,
      hasMedia: numMedia > 0,
      createdAt: admin.firestore.FieldValue.serverTimestamp(),
    });

    console.log("Mesaj WhatsApp save:", MessageSid);
    res.set("Content-Type", "text/xml");
    res.status(200).send("<Response></Response>");
  } catch (e) {
    console.error(e);
    res.status(500).send("Error");
  }
});

// ---------------------------------------------
// 🟢 VOUYE MESAJ KI NAN wa_queue VIA TWILIO
// ---------------------------------------------
exports.sendWhatsAppQueue = functions.firestore
  .document("wa_queue/{docId}")
  .onCreate(async (snap, ctx) => {
    const data = snap.data();
    if (data.status !== "pending") return null;

    const accountSid = functions.config().twilio.sid;
    const authToken = functions.config().twilio.token;
    const fromNumber = "whatsapp:+14155238886";
    const client = require("twilio")(accountSid, authToken);

    try {
      await client.messages.create({
        from: fromNumber,
        to: "whatsapp:" + data.to,
        body: data.message,
      });
      await snap.ref.update({ status: "sent", sentAt: admin.firestore.FieldValue.serverTimestamp() });
    } catch (e) {
      console.error("Twilio send error:", e);
      await snap.ref.update({ status: "failed", error: e.message });
    }
    return null;
  });
